<Window x:Class="BonbonPet.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="弹弹桌宠 · 设置" Width="830" Height="730" MinWidth="750" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#F6F8F2">
 <Grid Margin="26,22,26,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="弹弹桌宠设置" FontSize="26" FontWeight="Bold"/><TextBlock Text="调整音频律动、互动效果、漂浮运动和随机对话。" Foreground="{StaticResource Muted}" FontSize="12" Margin="1,8,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="#E5F2EA" CornerRadius="14" Padding="12,7" VerticalAlignment="Top"><TextBlock Text="●  桌宠运行中" Foreground="#4F8870" FontSize="12"/></Border>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#E8F2EE" CornerRadius="22" Padding="19">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="角色预览" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="动画与互动效果" Foreground="#82A198" FontSize="10" Margin="0,8,0,0"/></StackPanel>
     <Grid Grid.Row="1"><Ellipse Fill="#D5E8DE" Width="170" Height="170"/><Image x:Name="PreviewImage" Width="185" Height="220" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform x:Name="PreviewScale"/></Image.RenderTransform></Image></Grid>
     <StackPanel Grid.Row="2">
      <Border Background="#FFFDF4" CornerRadius="14" Padding="14" Margin="0,0,0,17"><TextBlock x:Name="PreviewPhrase" Text="随机对话预览" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="160" FontSize="13.5" LineHeight="21" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center"/></Border>
      <Button Content="预览按压效果" Click="Squeeze_Click" Background="#2F8D80" Foreground="White"/>
      <TextBlock Text="按下压缩 · 松开回弹 · 按住拖动&#x0a;右键桌宠或托盘图标可打开设置" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,13,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <TabControl x:Name="SettingsTabs" Grid.Column="2" Background="Transparent" BorderThickness="0">
    <TabItem Header="基本设置"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,14,8,0">
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="音频律动" Style="{StaticResource SectionTitle}"/>
      <CheckBox x:Name="AudioCheck" Content="跟随系统播放音频律动" Checked="ControlsChanged" Unchecked="ControlsChanged"/>
      <ProgressBar x:Name="AudioMeter" Minimum="0" Maximum="1" Height="6" Foreground="#53B6A4" Background="#EAF0EA" BorderThickness="0" Margin="0,3,0,8"/>
      <TextBlock x:Name="AudioStatus" Style="{StaticResource Hint}" Text="正在接入系统音频…"/>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="律动灵敏度" FontSize="12"/><TextBlock x:Name="SensitivityText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
      <Slider x:Name="SensitivitySlider" Minimum="0.2" Maximum="4" TickFrequency="0.1" ValueChanged="SliderChanged"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="按压效果" Style="{StaticResource SectionTitle}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="弹性幅度" FontSize="12"/><TextBlock x:Name="SqueezeText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
      <Slider x:Name="SqueezeSlider" Minimum="0" Maximum="3" TickFrequency="0.1" ValueChanged="SliderChanged"/>
      <TextBlock Text="数值越大，按压形变越明显；设为 0 时只播放音效。" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
      <TextBlock Text="按压音效" FontSize="12" Margin="0,0,0,8"/>
      <ComboBox x:Name="SoundCombo" SelectionChanged="SoundChanged" Padding="8"><ComboBoxItem Content="合成音效" Tag="original"/><ComboBoxItem Content="橡胶鸭音效（按下 / 松开）" Tag="duck"/><ComboBoxItem Content="自定义 WAV / MP3" Tag="custom"/></ComboBox>
      <TextBlock x:Name="CustomSoundText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="0,7,0,7"/>
      <WrapPanel><Button Content="导入自定义音效" Click="ImportSound_Click" Padding="12,8" Margin="0,0,8,8"/><Button Content="试听并预览" Click="Squeeze_Click" Padding="12,8" Margin="0,0,0,8"/></WrapPanel>
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="音效音量" FontSize="12"/><TextBlock x:Name="VolumeText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
      <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" ValueChanged="SliderChanged"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="桌面显示" Style="{StaticResource SectionTitle}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="角色大小" FontSize="12"/><TextBlock x:Name="SizeText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
      <Slider x:Name="SizeSlider" Minimum="72" Maximum="480" ValueChanged="SliderChanged"/>
      <CheckBox x:Name="TopmostCheck" Content="显示在其他窗口上方" Checked="ControlsChanged" Unchecked="ControlsChanged"/>
      <CheckBox x:Name="FullscreenCheck" Content="其他应用全屏时自动隐藏" Checked="ControlsChanged" Unchecked="ControlsChanged"/>
      <TextBlock Text="按住角色可拖动位置；关闭漂浮后，角色停在当前位置。" Style="{StaticResource Hint}"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="漂浮运动"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,14,8,0">
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="漂浮与旋转" Style="{StaticResource SectionTitle}"/>
      <CheckBox x:Name="PhysicsCheck" Content="启用自由旋转和屏幕边缘反弹" Checked="ControlsChanged" Unchecked="ControlsChanged"/>
      <TextBlock Text="角色在当前屏幕内移动，碰到边缘时反弹。按住可拖动，松开后按拖动速度继续移动。" Style="{StaticResource Hint}"/>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="随机推进速度" FontSize="12"/><TextBlock x:Name="SpeedText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
      <Slider x:Name="SpeedSlider" Minimum="25" Maximum="650" ValueChanged="SliderChanged"/>
      <CheckBox x:Name="DecayCheck" Content="启用速度衰减" Checked="ControlsChanged" Unchecked="ControlsChanged"/>
      <TextBlock Text="启用后移动和旋转逐渐减速；关闭后保持速度。" Style="{StaticResource Hint}"/>
      <Button Content="随机推进一次" Click="Kick_Click" Margin="0,10,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="自动推进" Style="{StaticResource SectionTitle}"/>
      <CheckBox x:Name="AutoKickCheck" Content="定时沿随机方向推进" Checked="ControlsChanged" Unchecked="ControlsChanged"/>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="推进间隔" FontSize="12"/><TextBlock x:Name="KickText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
      <Slider x:Name="KickSlider" Minimum="3" Maximum="120" ValueChanged="SliderChanged"/>
      <TextBlock Text="自动推进仅在启用漂浮时生效。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="动画帧率" Style="{StaticResource SectionTitle}"/>
      <ComboBox x:Name="FpsCombo" SelectionChanged="FpsChanged" Padding="8" Margin="0,0,0,10"><ComboBoxItem Content="20 帧 · 省电" Tag="20"/><ComboBoxItem Content="30 帧 · 均衡" Tag="30"/><ComboBoxItem Content="60 帧 · 推荐 / 流畅" Tag="60"/></ComboBox>
      <TextBlock Text="默认 60 帧。隐藏时暂停动画和音频律动，可从托盘图标恢复显示。" Style="{StaticResource Hint}"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="素材与对话"><ScrollViewer x:Name="DialogueScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,14,8,0">
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="角色素材" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="CharacterText" Text="默认角色 GIF" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,0,0,12"/>
      <WrapPanel><Button Content="选择图片 / GIF" Click="Import_Click" Margin="0,0,8,8"/><Button Content="恢复默认" Click="Default_Click" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="支持 GIF、PNG、JPG、BMP。透明素材可保留透明背景，GIF 可播放动画；导入素材会保存在本地。" Style="{StaticResource Hint}"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="随机对话" Style="{StaticResource SectionTitle}"/>
      <CheckBox x:Name="BubblesCheck" Content="启用随机对话框" Checked="ControlsChanged" Unchecked="ControlsChanged"/>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="出现间隔" FontSize="12"/><TextBlock x:Name="BubbleText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
      <Slider x:Name="BubbleSlider" Minimum="10" Maximum="180" ValueChanged="SliderChanged"/>
      <TextBlock Text="对话字体" FontSize="12" Margin="0,12,0,6"/>
      <ComboBox x:Name="FontCombo" IsEditable="True" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" DisplayMemberPath="Source" TextSearch.TextPath="Source" SelectionChanged="FontChanged" TextBoxBase.TextChanged="FontTextChanged" LostKeyboardFocus="FontLostFocus" MaxDropDownHeight="250" Padding="8"/>
      <TextBlock Text="输入字体名称可查找已安装字体。" Style="{StaticResource Hint}" Margin="0,6,0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="字体大小" FontSize="12"/><TextBlock x:Name="FontSizeText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
      <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="32" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/>
      <Button Content="预览随机对话" Click="Say_Click" Margin="0,12,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="预设对话" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="每行一句，可直接修改或删除；清空后不再使用预设对话。" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
      <TextBox x:Name="PresetPhrasesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" TextChanged="PresetPhrasesChanged" MaxLength="5000"/>
      <Button x:Name="RestorePresetButton" Content="恢复预设对话" Click="RestorePreset_Click" Margin="0,12,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="自定义对话" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="每行一句，与预设对话随机混合；已有内容会保留。每句最多显示 110 个字符。" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
      <TextBox x:Name="PhrasesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" TextChanged="PhrasesChanged" MaxLength="5000"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="关于与更新"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,14,8,0">
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="弹弹桌宠" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="VersionText" FontSize="13" Margin="0,0,0,14"/>
      <TextBlock Text="检查 GitHub 上的最新正式版本。" Style="{StaticResource Hint}"/>
      <WrapPanel Margin="0,12,0,0"><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Margin="0,0,8,8"/><Button x:Name="UpdateDownloadButton" Content="下载新版本" Click="UpdateDownload_Click" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock x:Name="UpdateStatusText" Text="尚未检查更新。" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,12"/>
      <Button Content="打开 GitHub 发布页" Click="OpenReleases_Click"/>
      <TextBlock Text="点击“检查更新”时才访问 GitHub。下载按钮会打开发布页，由你选择下载和替换程序。" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
  </Grid>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="FooterStatus" Text="设置自动保存 · v0.4" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="关闭设置" Click="Close_Click" Padding="20,9"/>
  </Grid>
 </Grid>
</Window>
