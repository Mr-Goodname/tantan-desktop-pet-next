<Window x:Class="BonbonPet.PetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="弹弹桌宠" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ShowActivated="False" Width="407" Height="407" Topmost="True" UseLayoutRounding="True">
 <Grid>
  <Image x:Name="PetImage" Width="220" Height="220" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
   RenderTransformOrigin="0.5,0.5" Cursor="Hand" ToolTip="按下压缩，松开回弹；按住拖动；右键打开菜单" RenderOptions.BitmapScalingMode="LowQuality">
   <Image.RenderTransform><TransformGroup>
    <ScaleTransform x:Name="Squash" ScaleX="1" ScaleY="1"/>
    <RotateTransform x:Name="Spin" Angle="0"/>
    <TranslateTransform x:Name="Bounce" X="0" Y="0"/>
   </TransformGroup></Image.RenderTransform>
  </Image>
 </Grid>
</Window>
